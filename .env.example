# AniChain — copy to `.env` (repo root) or to `backend/.env` / `scraper/.env`.
# backend/.env and scraper/.env take precedence over this root file when both exist.

# ─── Backend (Hono + Drizzle) ────────────────────────────────────────────────
# Aiven: Console → your PostgreSQL service → Overview → Service URI.
# Local test DB: postgres://anichain:anichain@localhost:5433/anichain
DATABASE_URL=postgres://avnadmin:PASSWORD@your-service-your-project.aivencloud.com:12345/defaultdb?sslmode=require
# Path to Aiven's CA certificate (Overview → CA certificate → download ca.pem).
# Enables full TLS verification. Leave empty for a local Postgres.
DATABASE_CA_CERT=
# At least 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# HTTP API port.
PORT=3000
# WebSocket port. Same as PORT (default) → WS served at ws://host:PORT/ws.
# Different value → a separate WS listener at ws://host:WS_PORT/ws.
WS_PORT=3000
# Credentials for the admin (manual price entry) login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars
CORS_ORIGIN=*
# Optional: enables AI price insights (Claude) on the commodity screen. Leave empty to disable.
# Get a key at https://console.anthropic.com/ . Server-side only — never put it in the mobile app.
ANTHROPIC_API_KEY=

# ─── Scraper (Python) ────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3000
# Service token with role=ingest: `cd backend && npm run token`
INGEST_TOKEN=
# Source to poll. `json` or `html_table`. For local testing: python scraper/mock_source.py
SOURCE_URL=http://localhost:8765/bulletin.json
SOURCE_FORMAT=json
# Market key used when a source row has no market column (bankerohan | agdao | davao-city).
SOURCE_MARKET=davao-city
# Seconds between polls (min 30). 60–120 recommended.
SCRAPE_INTERVAL=90

# ─── Mobile (Expo) ───────────────────────────────────────────────────────────
# Put these in mobile/.env (Expo only reads .env from the app folder).
# Optional. In development the app defaults to http://<dev-server-host>:3000.
# EXPO_PUBLIC_ vars are inlined into the JS bundle — never put secrets here.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=
